rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'msftashop@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function sessionExists(userId, sessionId) {
      return exists(/databases/$(database)/documents/users/$(userId)/sessions/$(sessionId));
    }

    // 3. Entity Validation Blueprints
    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid == adminUid &&
        data.role is string && data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'testingBypass', 'testingAllowance', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'displayName', 'testingBypass', 'testingAllowance', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.testingBypass is bool &&
        data.testingAllowance is int && data.testingAllowance >= 0 && data.testingAllowance <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConversation(data, userId, conversationId) {
      return data.keys().hasAll([
          'userId',
          'conversationId',
          'title',
          'systemVersion',
          'modelId',
          'messagesPayload',
          'messageCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'conversationId',
          'title',
          'systemVersion',
          'modelId',
          'messagesPayload',
          'messageCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId == userId &&
        data.conversationId is string && data.conversationId.size() >= 1 && data.conversationId.size() <= 128 &&
        data.conversationId == conversationId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.systemVersion is string && (data.systemVersion == 'v1' || data.systemVersion == 'v2') &&
        data.modelId is string && data.modelId.size() >= 1 && data.modelId.size() <= 64 &&
        data.messagesPayload is string && data.messagesPayload.size() >= 2 && data.messagesPayload.size() <= 250000 &&
        data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 5000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSession(data, userId, sessionId) {
      return data.keys().hasAll([
          'userId',
          'sessionId',
          'title',
          'systemVersion',
          'modelId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'sessionId',
          'title',
          'systemVersion',
          'modelId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId == userId &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
        data.sessionId == sessionId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.systemVersion is string && (data.systemVersion == 'v1' || data.systemVersion == 'v2') &&
        data.modelId is string && data.modelId.size() >= 1 && data.modelId.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSessionMessage(data, userId, sessionId, messageId) {
      return data.keys().hasAll([
          'userId',
          'sessionId',
          'messageId',
          'role',
          'text',
          'modelId',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'sessionId',
          'messageId',
          'role',
          'text',
          'modelId',
          'createdAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId == userId &&
        data.sessionId is string && data.sessionId.size() >= 1 && data.sessionId.size() <= 128 &&
        data.sessionId == sessionId &&
        data.messageId is string && data.messageId.size() >= 1 && data.messageId.size() <= 128 &&
        data.messageId == messageId &&
        data.role is string && (data.role == 'user' || data.role == 'ai') &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 32000 &&
        data.modelId is string && data.modelId.size() >= 1 && data.modelId.size() <= 64 &&
        data.createdAt is timestamp;
    }

    function isValidMemory(data, userId, memoryId) {
      return data.keys().hasAll(['userId', 'memoryId', 'fact', 'topic', 'sourceModel', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'memoryId', 'fact', 'topic', 'sourceModel', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId == userId &&
        data.memoryId is string && data.memoryId.size() >= 1 && data.memoryId.size() <= 128 &&
        data.memoryId == memoryId &&
        data.fact is string && data.fact.size() >= 1 && data.fact.size() <= 1000 &&
        data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 80 &&
        data.sourceModel is string && data.sourceModel.size() >= 1 && data.sourceModel.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDailyUsage(data, userId, usageKey) {
      return data.keys().hasAll([
          'userId',
          'usageKey',
          'dateRiyadh',
          'modelId',
          'count',
          'dailyLimit',
          'testingCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'userId',
          'usageKey',
          'dateRiyadh',
          'modelId',
          'count',
          'dailyLimit',
          'testingCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userId == userId &&
        data.usageKey is string && data.usageKey.size() >= 1 && data.usageKey.size() <= 128 &&
        data.usageKey == usageKey &&
        data.dateRiyadh is string && data.dateRiyadh.size() == 10 &&
        data.dateRiyadh.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.modelId is string &&
        (data.modelId == 'smfta-v5' || data.modelId == 'smfta-v2-pro' || data.modelId == 'smfta-max') &&
        data.count is int && data.count >= 0 && data.count <= 10000 &&
        data.dailyLimit is int && data.dailyLimit >= 1 && data.dailyLimit <= 10000 &&
        data.testingCount is int && data.testingCount >= 0 && data.testingCount <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSystemConfig(data, configId) {
      return data.keys().hasAll([
          'configId',
          'v5Limit',
          'proLimit',
          'maxLimit',
          'testingAllowance',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'configId',
          'v5Limit',
          'proLimit',
          'maxLimit',
          'testingAllowance',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.configId is string && data.configId.size() >= 1 && data.configId.size() <= 128 &&
        data.configId == configId &&
        data.v5Limit is int && data.v5Limit >= 1 && data.v5Limit <= 10000 &&
        data.proLimit is int && data.proLimit >= 1 && data.proLimit <= 10000 &&
        data.maxLimit is int && data.maxLimit >= 1 && data.maxLimit <= 10000 &&
        data.testingAllowance is int && data.testingAllowance >= 0 && data.testingAllowance <= 10000 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow create: if isBootstrappedAdmin() &&
        isValidId(adminUid) &&
        isValidAdminRecord(incoming(), adminUid) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(userId) && incoming().testingBypass == false && incoming().testingAllowance == 0) ||
          isAdmin()
        );
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isOwner(userId) &&
            incoming().testingBypass == existing().testingBypass &&
            incoming().testingAllowance == existing().testingAllowance &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])) ||
          (isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'testingBypass', 'testingAllowance', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(userId);

      match /conversations/{conversationId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(conversationId) && (isOwner(userId) || isAdmin()) && userExists(userId);
        allow list: if isSignedIn() && existing().userId == request.auth.uid;
        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(conversationId) &&
          isValidConversation(incoming(), userId, conversationId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isOwner(userId) &&
          userExists(userId);
        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(conversationId) &&
          isValidConversation(incoming(), userId, conversationId) &&
          incoming().userId == existing().userId &&
          incoming().conversationId == existing().conversationId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (isOwner(userId) &&
              userExists(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title',
                'systemVersion',
                'modelId',
                'messagesPayload',
                'messageCount',
                'updatedAt'
              ])) ||
            isAdmin()
          );
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(conversationId) && (isOwner(userId) || isAdmin()) && userExists(userId);
      }

      match /sessions/{sessionId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin()) && userExists(userId);
        allow list: if isSignedIn() && existing().userId == request.auth.uid;
        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          isValidSession(incoming(), userId, sessionId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isOwner(userId) &&
          userExists(userId);
        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          isValidSession(incoming(), userId, sessionId) &&
          incoming().userId == existing().userId &&
          incoming().sessionId == existing().sessionId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (isOwner(userId) &&
              userExists(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'title',
                'systemVersion',
                'modelId',
                'updatedAt'
              ])) ||
            isAdmin()
          );
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin()) && userExists(userId);

        match /messages/{messageId} {
          allow get: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && isValidId(messageId) && (isOwner(userId) || isAdmin()) && userExists(userId) && sessionExists(userId, sessionId);
          allow list: if isSignedIn() && existing().userId == request.auth.uid;
          allow create: if isSignedIn() &&
            isValidId(userId) &&
            isValidId(sessionId) &&
            isValidId(messageId) &&
            isValidSessionMessage(incoming(), userId, sessionId, messageId) &&
            incoming().createdAt == request.time &&
            isOwner(userId) &&
            userExists(userId) &&
            sessionExists(userId, sessionId);
          allow update: if isSignedIn() &&
            isValidId(userId) &&
            isValidId(sessionId) &&
            isValidId(messageId) &&
            isValidSessionMessage(incoming(), userId, sessionId, messageId) &&
            incoming().userId == existing().userId &&
            incoming().sessionId == existing().sessionId &&
            incoming().messageId == existing().messageId &&
            incoming().role == existing().role &&
            incoming().createdAt == existing().createdAt &&
            (
              (isOwner(userId) &&
                userExists(userId) &&
                sessionExists(userId, sessionId) &&
                incoming().diff(existing()).affectedKeys().hasOnly(['text', 'modelId'])) ||
              isAdmin()
            );
          allow delete: if isSignedIn() && isValidId(userId) && isValidId(sessionId) && isValidId(messageId) && (isOwner(userId) || isAdmin()) && userExists(userId) && sessionExists(userId, sessionId);
        }
      }

      match /memories/{memoryId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(memoryId) && (isOwner(userId) || isAdmin()) && userExists(userId);
        allow list: if isSignedIn() && existing().userId == request.auth.uid;
        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(memoryId) &&
          isValidMemory(incoming(), userId, memoryId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isOwner(userId) &&
          userExists(userId);
        allow update: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(memoryId) &&
          isValidMemory(incoming(), userId, memoryId) &&
          incoming().userId == existing().userId &&
          incoming().memoryId == existing().memoryId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            (isOwner(userId) &&
              userExists(userId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['fact', 'topic', 'sourceModel', 'updatedAt'])) ||
            isAdmin()
          );
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(memoryId) && (isOwner(userId) || isAdmin()) && userExists(userId);
      }

      match /usage/{usageKey} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(usageKey) && (isOwner(userId) || isAdmin()) && userExists(userId);
        allow list: if isSignedIn() && existing().userId == request.auth.uid;
        // Normal clients can NEVER write or tamper with their own quota counters.
        allow create: if isAdmin() &&
          isValidId(userId) &&
          isValidId(usageKey) &&
          isValidDailyUsage(incoming(), userId, usageKey) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          userExists(userId);
        allow update: if isAdmin() &&
          isValidId(userId) &&
          isValidId(usageKey) &&
          isValidDailyUsage(incoming(), userId, usageKey) &&
          incoming().userId == existing().userId &&
          incoming().usageKey == existing().usageKey &&
          incoming().dateRiyadh == existing().dateRiyadh &&
          incoming().modelId == existing().modelId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['count', 'dailyLimit', 'testingCount', 'updatedAt']);
        allow delete: if isAdmin() && isValidId(userId) && isValidId(usageKey);
      }
    }

    match /system_configs/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow create: if isAdmin() &&
        isValidId(configId) &&
        isValidSystemConfig(incoming(), configId) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(configId) &&
        isValidSystemConfig(incoming(), configId) &&
        incoming().configId == existing().configId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'v5Limit',
          'proLimit',
          'maxLimit',
          'testingAllowance',
          'updatedBy',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
